# 複製成 .env 後修改（.env 不進版本控制）
# cp .env.example .env

# 資料庫（MariaDB 容器初始化與 API 連線都用這幾個值）
DB_NAME=trello
DB_USER=trello
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# 本機對外的資料庫連接埠（給 DBeaver 等工具用）
DB_PORT_HOST=3308

# Session 簽章用的密鑰，請換成一組隨機字串：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string
